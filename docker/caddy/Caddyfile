{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    handle /api/* {
        reverse_proxy backend-nginx:80
    }

    handle /sanctum/* {
        reverse_proxy backend-nginx:80
    }

    handle /storage/* {
        reverse_proxy backend-nginx:80
    }

    handle {
        reverse_proxy frontend:3000
    }
}
